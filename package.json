{
  "name": "proyecto_admin",
  "version": "1.0.0",
  "description": "API para administración dental",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "sync-db": "node scripts/syncDB.js",
    "test": "jest --coverage --passWithNoTests",
    "test:load": "artillery run tests/load/artillery-config.yml",
    "test:load:report": "artillery run --output tests/load/report.json tests/load/artillery-config.yml && artillery report tests/load/report.json"
  },
  "keywords": [
    "dental",
    "api",
    "appointments"
  ],
  "author": "Tu nombre",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-validator": "^7.3.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.15.3",
    "nodemailer": "^7.0.10",
    "nodemon": "^3.1.10",
    "sequelize": "^6.37.7"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "artillery": "^2.0.32",
    "jest": "^30.4.2",
    "supertest": "^7.2.2"
  }
}
